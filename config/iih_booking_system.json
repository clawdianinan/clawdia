{
  "system": "IIH Booking System",
  "version": "1.0",
  "owner_agent": "aisha",
  "timezone": "Africa/Lagos",
  "status_model": [
    "Draft",
    "Pending Availability",
    "Tentative",
    "Invoice Sent",
    "Payment Pending",
    "Confirmed",
    "Cancelled",
    "Refund Review"
  ],
  "contacts": {
    "booking_inbox": "facilitybookings@iih.ng",
    "booking_from": "facilitybookings@iih.ng",
    "booking_reply_to": "facilitybookings@iih.ng",
    "events_cc": "events@iih.ng",
    "events_manager": "maureen@iih.ng",
    "approval_owner": "temi@iih.ng",
    "excluded_booking_identities": [
      "md@iih.ng"
    ]
  },
  "facilities": {
    "Main Hall": {
      "billing_mode": "day",
      "rate_ngn": 750000,
      "zoho_books_item_id": "6104627000000136098"
    },
    "Pitch Hall": {
      "billing_mode": "day",
      "rate_ngn": 400000,
      "zoho_books_item_id": "6104627000000136021"
    },
    "Meeting Room": {
      "billing_mode": "hour",
      "rate_ngn": 20000,
      "zoho_books_item_id": "6104627000000250451"
    },
    "Private Office": {
      "billing_mode": "day",
      "rate_ngn": 25000,
      "zoho_books_item_id": "6104627000000151001",
      "available": false
    }
  },
  "event_policy": {
    "allowed_event_focus": [
      "technology",
      "innovation",
      "entrepreneurship",
      "youth development"
    ],
    "initial_response_rule": "deduce available details from the enquiry first, do not list deduced details in the autoresponder, and ask only for missing or unclear fields",
    "external_catering_policy": "external catering is not allowed by default; exceptions attract a NGN 100,000 per day corkage fee"
  },
  "booking_form": {
    "url": "https://forms.gle/psuxSJ4MG1CqQWKD8",
    "autoresponder_rule": "include this link when asking clients to complete a full booking request"
  },
  "keychain_services": {
    "account": "iih-booking",
    "ZOHO_CLIENT_ID": "iih-booking-ZOHO_CLIENT_ID",
    "ZOHO_CLIENT_SECRET": "iih-booking-ZOHO_CLIENT_SECRET",
    "ZOHO_REFRESH_TOKEN": "iih-booking-ZOHO_REFRESH_TOKEN",
    "ZOHO_BOOKS_ORG_ID": "iih-booking-ZOHO_BOOKS_ORG_ID",
    "ZOHO_APP_PASSWORD": "iih-booking-ZOHO_APP_PASSWORD",
    "ZOHO_CALENDAR_UID": "iih-booking-ZOHO_CALENDAR_UID"
  },
  "fees": {
    "refundable_security_deposit": {
      "rate_ngn": 100000,
      "always_apply": true,
      "zoho_books_item_id": "6104627000000150065"
    },
    "external_catering_corkage": {
      "rate_ngn": 100000,
      "billing_mode": "day",
      "apply_when": "external_catering == true"
    }
  },
  "required_secrets": [
    "ZOHO_CLIENT_ID",
    "ZOHO_CLIENT_SECRET",
    "ZOHO_REFRESH_TOKEN",
    "ZOHO_BOOKS_ORG_ID",
    "ZOHO_APP_PASSWORD",
    "ZOHO_EMAIL",
    "ZOHO_FROM",
    "ZOHO_CALENDAR_UID"
  ],
  "email_runtime": {
    "required_himalaya_account": "facilitybookings",
    "sender_policy": "all booking-related emails must use facilitybookings@iih.ng; md@iih.ng is excluded from this system"
  },
  "agent_runtime": {
    "poll_account": "facilitybookings",
    "poll_folder": "INBOX",
    "recommended_interval_minutes": 10,
    "state_database": "documents/IIH/Bookings/booking_agent.sqlite3",
    "thread_detection": [
      "Message-ID",
      "In-Reply-To",
      "References",
      "normalized_subject",
      "sender_email"
    ],
    "response_policy": {
      "all_outbound_responses_cc": [
        "events@iih.ng"
      ],
      "signature_after_current_booking": "Aisha\nIIH Facility Booking Agent",
      "invoice_payment_goal": "send invoice, wait for matching payment proof, then mark calendar event confirmed with events@iih.ng",
      "approved_automation_sends": [
        "send_invoice_email_with_attachment",
        "send_payment_reminder"
      ],
      "external_send_gate": "booking agent may send approved invoice emails and payment reminders for validated booking threads; other external sends still require explicit approval"
    }
  },
  "credential_policy": {
    "existing_tokens_approved_by_temi": true,
    "rotation_required_before_production": false,
    "storage_rule": "secure runtime, keychain, or environment only; never commit secrets",
    "replacement_trigger": "only if authentication fails, token is revoked, or Temi later requests rotation",
    "approved_on": "2026-06-15"
  },
  "approval_gates": [
    "send_invoice_email",
    "send_acknowledgement_email",
    "create_external_calendar_invite",
    "confirm_payment",
    "issue_refund",
    "approve_discount_or_waiver",
    "respond_to_third_party"
  ]
}
