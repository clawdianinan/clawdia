{
  "name": "accessibility-implementation",
  "version": "1.0.0",
  "description": "Comprehensive accessibility features for React applications including screen reader optimization, keyboard navigation, and cognitive accessibility",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run build:css",
    "build:css": "cp src/styles/accessibility.css dist/styles/",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx,css}",
    "prepare": "npm run build"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "react",
    "screen-reader",
    "keyboard-navigation",
    "wcag",
    "aria",
    "disability",
    "inclusive-design"
  ],
  "author": "Clawdia AI",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clawdianinan/accessibility-implementation.git"
  },
  "bugs": {
    "url": "https://github.com/clawdianinan/accessibility-implementation/issues"
  },
  "homepage": "https://github.com/clawdianinan/accessibility-implementation#readme",
  "dependencies": {}
}